node_modules/
.tgplayer-data/
dist/

# Editor/tooling session metadata (topic titles, timestamps) -- not part of the project.
.reasonix/

# electron-builder output and its download cache (electron zip, nsis, winCodeSign).
# The cache is kept on disk so rebuilds skip the ~110MB download, but it is
# machine-local and must never be committed.
dist-final/
.build-cache/

# Local build output used while dist-final was locked by another process.
dist-build/

# Runtime diagnostics and dependency download caches -- machine-local only.
runtime-logs/
.electron-cache/
.npm-cache/

# Stray crash/log droppings that landed in the repo root as bare numbers.
/[0-9]*
